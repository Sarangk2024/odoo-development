<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    vehicle model form view  -->
    <record id="vehicle_management_form_view" model="ir.ui.view">
        <field name="name">vehicle.management.form.view</field>
        <field name="model">vehicle.management</field>
        <field name="arch" type="xml">
            <form string="Form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vehicle_history" type="object"
                                class="oe_stat_button" icon="history"
                                invisible="history_count == 0">
                            <field name="history_count" widget="statinfo"
                                   string="History"/>
                        </button>

                        <button name="action_view_appointments" type="object"
                                class="oe_stat_button" icon="edit_square"
                                invisible="appointment_count == 0">
                            <field name="appointment_count" widget="statinfo"
                                   string="Appointment"/>
                        </button>

                    </div>
                    <div class="oe_title">
                        <label for="license_plate"/>
                        <h1>
                            <field name="license_plate"
                                   placeholder="License Plate"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="vin"/>
                            <field name="make"/>
                            <field name="model"/>
                            <field name="year"/>
                        </group>

                        <group>
                            <field name="colour"/>
                            <field name="odometer"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--    vehicle model list view    -->
    <record id="vehicle_management_list_view" model="ir.ui.view">
        <field name="name">vehicle.management.list.view</field>
        <field name="model">vehicle.management</field>
        <field name="arch" type="xml">
            <list>
                <field name="license_plate"/>
                <field name="vin"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="colour"/>
                <field name="odometer"/>
                <field name="owner_id"/>
            </list>
        </field>
    </record>

    <!--    vehicle model search   -->
    <record id="vehicle_management_search" model="ir.ui.view">
        <field name="name">vehicle.mode.search</field>
        <field name="model">vehicle.management</field>
        <field name="arch" type="xml">
            <search string="vehicle Bay">
                <field name="license_plate"/>
                <field name="vin"/>
                <field name="make"/>
                <field name="model"/>
                <field name="year"/>
                <field name="odometer"
                       filter_domain="[('odometer','>=', self)]"/>
                <field name="colour"/>
                <field name="owner_id"/>

                <filter string="Honda" name="Honda"
                        domain="[('make', '=', 'Honda')]"/>
                <filter string="Toyota" name="Toyota"
                        domain="[('make', '=', 'Toyota')]"/>
                <filter string="Ford" name="Ford"
                        domain="[('make', '=', 'Ford')]"/>


                <group>
                    <filter string="Vehicle make" name="make"
                            context="{'group_by':'make'}"/>
                    <filter string="Year" name="year"
                            context="{'group_by':'year'}"/>
                    <filter string="KM" name="odometer"
                            context="{'group_by':'odometer'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View Definition-->
    <record id="vehicle_maagement_view_kanban" model="ir.ui.view">
        <field name="name">vehicle.managementview.kanban</field>
        <field name="model">vehicle.management</field>
        <field name="arch" type="xml">
            <kanban default_group_by="owner_id" sample="1" quick_create="false">
                <templates>
                    <t t-name="card">
                        <div class="d-flex mb-2 justify-content-between align-items-center">
                            <field name="make" class="fw-bolder fs-5"/>
                            <field name="model" class="text-muted"/>
                            <field name="license_plate"/>
                        </div>
                        <div class="text-muted mb-2">
                            <field name="year"/>
                        </div>
                        <footer class="pt-1">
                            <field name="vin"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--    vehicle model action   -->
    <record id="vehicle_management_action" model="ir.actions.act_window">
        <field name="name">Vehicle</field>
        <field name="res_model">vehicle.management</field>
        <field name="view_mode">list,form,kanban</field>
    </record>
</odoo>