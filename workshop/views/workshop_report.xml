<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    workshop joborder model search   -->
    <record id="workshop_job_order_search" model="ir.ui.view">
        <field name="name">workshop.job.order.model.search</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <search string="workshop job order">
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="mechanic_ids"/>
                <field name="bay_id"/>
                <field name="job_date"/>
                <field name="state"/>

                <filter string="To Invoice" name="to_invoice"
                        domain="[('state', 'in',['done','quotation'])]"/>
                <filter string="Canceled" name="cancel"
                        domain="[('state', '=', 'cancel')]"/>
                <filter string="Invoiced" name="invoiced"
                        domain="[('state', '=', 'invoiced')]"/>
                <separator/>
                <filter string="Last 24h" name="last_24h"
                        domain="[('job_date', '&gt;', (context_today() - relativedelta(days=1)))]"/>
                <group>
                    <filter string="Status" name="state"
                            context="{'group_by':'state'}"/>
                    <filter string="Vehicle" name="vehicle"
                            context="{'group_by':'vehicle_id'}"/>
                    <filter string="Customer" name="customer"
                            context="{'group_by':'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban View Definition-->
    <record id="workshop_job_order_view_kanban" model="ir.ui.view">
        <field name="name">workshop.job.order.view.kanban</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <kanban default_group_by="customer_id" sample="1"
                    quick_create="false">
                <templates>
                    <t t-name="card">
                        <div class="d-flex mb-2 justify-content-between align-items-center">
                            <field name="sequence" class="fw-bolder fs-5"/>
                            <field name="job_date" class="text-muted"/>
                        </div>
                        <div class="text-muted mb-2">
                            <field name="customer_notes"/>
                        </div>
                        <footer class="pt-1">
                            <field name="vehicle_id"/>
                            <field name="activity_ids"
                                   widget="kanban_activity"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!--    pivot view Definition-->
    <record id="workshop_job_order_view_pivot" model="ir.ui.view">
        <field name="name">workshop.job.order.view.pivot</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <pivot string="Workshop Job Order" sample="1">
                <field name="customer_id" type="measure"/>
                <field name="mechanic_ids" type="col"/>
                <field name="job_date" interval="day" type="col"/>
                <field name="state" type="col"/>
                <field name="total_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <!--    graph view Definition-->
    <record id="workshop_job_order_view_graph" model="ir.ui.view">
        <field name="name">workshop.job.order.view.graph</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <graph string="Workshop Job Order" type="line" sample="1">
                <field name="customer_id" type="measure"/>
                <field name="mechanic_ids"/>
                <field name="job_date"/>
                <field name="state"/>
                <field name="total_amount" type="measure"/>
            </graph>
        </field>
    </record>

      <record id="workshop_report_action" model="ir.actions.act_window">
        <field name="name">Workshop Report</field>
        <field name="res_model">workshop.job.order</field>
        <field name="view_mode">pivot,graph</field>
    </record>
</odoo>

