<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_workshop"
              name="Portal layout : Work Order menu entries"
              inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li id="portal_breadcrumbs_workshop" t-if="page_name == 'Workshop'"
                t-attf-class="breadcrumb-item active">
                Work Orders
            </li>
            <li t-if="page_name == 'Workshop_details'"
                t-attf-class="breadcrumb-item">
                <a t-attf-href="/my/workshop">Work Orders</a>
            </li>
            <li t-if="page_name == 'Workshop_details'"
                t-attf-class="breadcrumb-item active">
                <t t-out="workdetails.sequence"/>
            </li>
        </xpath>
    </template>

    <template id="workshop_details_page" name="My Work Orders=">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">
            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True"
               title.translate="Work Orders"/>
            <t t-if="not workorders">
                <p class="alert alert-warning">There are currently no Work
                    orders for your account.
                </p>
            </t>
            <t t-if="workorders" t-call="portal.portal_table">
                <thead>
                    <tr class="active ">
                        <th name="sequence">Work Order #</th>
                        <th name="job_date">Work Order Date</th>
                        <th name="mechanic_ids">Mechanics</th>
                        <th name="vehicle_id" class="text-end">Vehicle</th>
                        <th name="total_amount" class="text-end">Amount</th>
                        <th name="state" class="text-end">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <t t-foreach="workorders" t-as="wo">
                            <tr>
                                <td>
                                    <a t-attf-href="/my/workshop/#{wo.id}">
                                        <t t-out="wo.sequence"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-out="wo.job_date"
                                          t-options='{"widget": "datetime", "hide_seconds": True}'/>
                                </td>
                                <td>
                                    <t t-out="wo.mechanic_ids.display_name"/>
                                </td>
                                <td class="text-end">
                                    <t t-out="wo.vehicle_id.license_plate"/>
                                </td>
                                <td class="text-end">
                                    <t t-out="wo.total_amount"
                                       t-options='{"widget": "monetary", "display_currency": wo.currency_id}'/>
                                </td>
                                <td class="text-end">
                                    <span t-if="wo.state == 'draft'"
                                          class="badge rounded-pill o_badge_color_0">
                                        <i class="oi oi-fw" data-icon="close"
                                           aria-label="draft"
                                           title="Draft" role="img"/>
                                        <span class="d-none d-md-inline">
                                            Draft
                                        </span>
                                    </span>
                                    <span t-elif="wo.state == 'confirmed'"
                                          class="badge rounded-pill text-bg-info">
                                        <i class="oi oi-fw" data-icon="person"
                                           aria-label="Confirmed"
                                           title="Confirmed" role="img"/>
                                        <span class="d-none d-md-inline">
                                            Confirmed
                                        </span>
                                    </span>
                                    <span t-elif="wo.state == 'in_progress'"
                                          class="badge rounded-pill text-bg-info">
                                        <i class="oi oi-fw" data-icon="work"
                                           aria-label="In_progress"
                                           title="In_progress" role="img"/>
                                        <span class="d-none d-md-inline">
                                            In Progress
                                        </span>
                                    </span>
                                    <span t-elif="wo.state == 'done'"
                                          class="badge rounded-pill text-bg-info">
                                        <i class="oi oi-fw" data-icon="check"
                                           aria-label="Done"
                                           title="Done" role="img"/>
                                        <span class="d-none d-md-inline">
                                            Done
                                        </span>
                                    </span>
                                    <span t-elif="wo.state == 'quotation'"
                                          class="badge rounded-pill text-bg-info">
                                        <i class="oi oi-fw" data-icon="circle"
                                           aria-label="Quotation"
                                           title="Quotation" role="img"/>
                                        <span class="d-none d-md-inline">
                                            Quotation
                                        </span>
                                    </span>
                                    <span t-elif="wo.state == 'invoiced'"
                                          class="badge rounded-pill text-bg-info">
                                        <i class="oi oi-fw" data-icon="business"
                                           aria-label="Invoiced"
                                           title="Invoiced" role="img"/>
                                        <span class="d-none d-md-inline">
                                            Invoiced
                                        </span>
                                    </span>
                                    <span t-elif="wo.state == 'delivered'"
                                          class="badge rounded-pill text-bg-info">
                                        <i class="oi oi-fw" data-icon="sell"
                                           aria-label="Delivered"
                                           title="Delivered" role="img"/>
                                        <span class="d-none d-md-inline">
                                            Delivered
                                        </span>
                                    </span>
                                    <span t-else=""
                                          class="badge rounded-pill text-bg-info">
                                        <i class="oi oi-fw" data-icon="schedule"
                                           aria-label="Unconfirmed"
                                           title="Unconfirmed" role="img"/>
                                        <span class="d-none d-md-inline">
                                            Unconfirmed
                                        </span>
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>

    <template id="workshop_work_order_details_page" name="My Work Orders=">
        <t t-call="portal.portal_layout" breadcrumbs_searchbar="True">
            <t t-call="portal.portal_searchbar" breadcrumbs_searchbar="True"
               title.translate="Work Orders"/>
            <t t-if="not workdetails">
                <p class="alert alert-warning">There are currently no Work
                    orders for your account.
                </p>
            </t>
            <h3>
                <t t-out="workdetails.sequence"/>
            </h3>
            <h5>
                Customer:
                <span>
                    <t t-out="workdetails.customer_id.name"/>
                </span>
            </h5>

            <h5>
                <span t-out="workdetails.job_date"
                      t-options='{"widget": "datetime", "hide_seconds": True}'/>
            </h5>
            <h5>
                Mechanics:
                <span>
                    <t t-out="workdetails.mechanic_ids.display_name"/>
                </span>
            </h5>
            <h5>
                Customer Notes:
                <span>
                    <t t-out="workdetails.customer_notes"/>
                </span>
            </h5>
            <h5>
                Images:
                <img t-att-src="workdetails.get('workdetails.image_id')"
                     class="img img-fluid oe_product_image_img h-100 w-100"/>
            </h5>
            <h5>
                <t t-out="workdetails.total_amount"
                   t-options='{"widget": "monetary", "display_currency": workdetails.currency_id}'/>
            </h5>
            <h5>
                <span t-if="workdetails.state == 'draft'"
                      class="badge rounded-pill o_badge_color_0">
                    <i class="oi oi-fw" data-icon="close"
                       aria-label="draft"
                       title="Draft" role="img"/>
                    <span class="d-none d-md-inline">
                        Draft
                    </span>
                </span>
                <span t-elif="workdetails.state == 'confirmed'"
                      class="badge rounded-pill text-bg-info">
                    <i class="oi oi-fw" data-icon="person"
                       aria-label="Confirmed"
                       title="Confirmed" role="img"/>
                    <span class="d-none d-md-inline">
                        Confirmed
                    </span>
                </span>
                <span t-elif="workdetails.state == 'in_progress'"
                      class="badge rounded-pill text-bg-info">
                    <i class="oi oi-fw" data-icon="work"
                       aria-label="In_progress"
                       title="In_progress" role="img"/>
                    <span class="d-none d-md-inline">
                        In Progress
                    </span>
                </span>
                <span t-elif="workdetails.state == 'done'"
                      class="badge rounded-pill text-bg-info">
                    <i class="oi oi-fw" data-icon="check"
                       aria-label="Done"
                       title="Done" role="img"/>
                    <span class="d-none d-md-inline">
                        Done
                    </span>
                </span>
                <span t-elif="workdetails.state == 'quotation'"
                      class="badge rounded-pill text-bg-info">
                    <i class="oi oi-fw" data-icon="circle"
                       aria-label="Quotation"
                       title="Quotation" role="img"/>
                    <span class="d-none d-md-inline">
                        Quotation
                    </span>
                </span>
                <span t-elif="workdetails.state == 'invoiced'"
                      class="badge rounded-pill text-bg-info">
                    <i class="oi oi-fw" data-icon="business"
                       aria-label="Invoiced"
                       title="Invoiced" role="img"/>
                    <span class="d-none d-md-inline">
                        Invoiced
                    </span>
                </span>
                <span t-elif="workdetails.state == 'delivered'"
                      class="badge rounded-pill text-bg-info">
                    <i class="oi oi-fw" data-icon="sell"
                       aria-label="Delivered"
                       title="Delivered" role="img"/>
                    <span class="d-none d-md-inline">
                        Delivered
                    </span>
                </span>
                <span t-else=""
                      class="badge rounded-pill text-bg-info">
                    <i class="oi oi-fw" data-icon="schedule"
                       aria-label="Unconfirmed"
                       title="Unconfirmed" role="img"/>
                    <span class="d-none d-md-inline">
                        Unconfirmed
                    </span>
                </span>
            </h5>

            <br/>
            <br/>
            <t t-if="not lines">
                <p class="alert alert-warning">There are currently no
                    orders lines for your Work Order.
                </p>
            </t>
            <t t-if="lines" t-call="portal.portal_table">
                <thead>
                    <tr class="active ">
                        <th name="product_id">Product</th>
                        <th name="quantity">Quantity</th>
                        <th name="product_unit_price">Unit Price</th>
                        <th name="line_subtotal" class="text-end">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td>
                                    <t t-out="line.product_id.name"/>
                                </td>
                                <td>
                                    <t t-out="line.quantity"/>
                                </td>
                                <td>
                                    <t t-out="line.product_unit_price"/>
                                </td>
                                <td class="text-end">
                                    <t t-out="line.line_subtotal"/>
                                </td>
                            </tr>
                        </t>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>
</odoo>
