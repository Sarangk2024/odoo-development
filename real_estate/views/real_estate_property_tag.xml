<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!--    list view for  tag model    -->

    <record id="real_estate_tag_list_view" model="ir.ui.view">
        <field name="name">real.estate.tag.list.view</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="tag_name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!--    form view for  tag model    -->

    <record id="real_estate_tag_view_form" model="ir.ui.view">
        <field name="name">real.estate.tag.form</field>
        <field name="model">estate.property.tag</field>
        <field name="arch" type="xml">
            <form string="Test">
                <sheet>
                    <group>
                        <group>
                            <field name="tag_name"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--    action view for  tag model    -->

    <record id="action_real_estate_tag" model="ir.actions.act_window">
        <field name="name">Property Tag</field>
        <field name="res_model">estate.property.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
