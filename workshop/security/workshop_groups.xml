<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="module_category_workshop" model="ir.module.category">
            <field name="name">Workshop</field>
            <field name="description">Access rights for My Workshop App</field>
        </record>

        <record model="res.groups.privilege" id="res_groups_privilege_workshop">
            <field name="name">Workshop</field>
            <field name="sequence">1</field>
            <field name="category_id" ref="module_category_workshop"/>
        </record>

        <record id="group_workshop_receptionist" model="res.groups">
            <field name="name">Receptionist</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_workshop"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Receptionist can create, view, and manage Job
                Orders, and they can create and update Vehicles.
            </field>
        </record>

        <record id="group_workshop_mechanic" model="res.groups">
            <field name="name">Mechanic</field>
            <field name="sequence">9</field>
            <field name="privilege_id" ref="res_groups_privilege_workshop"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Mechanic can view and update Job Orders
                assigned
                to them only, and
                they can only view all Vehicles.
            </field>
        </record>

        <record id="group_workshop_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="sequence">8</field>
            <field name="privilege_id" ref="res_groups_privilege_workshop"/>
            <field name="implied_ids"
                   eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Manager have full access to all Workshop
                records,
                access to reporting and analytics, and access to all Workshop
                management and configuration features, including Accounting
                configuration where applicable.
            </field>
        </record>
    </data>
</odoo>


