<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record forcecreate="True" id="ir_cron_workshop_appointment_reminder"
                model="ir.cron">
            <field name="name">Appointment Reminder</field>
            <field name="model_id" ref="workshop.model_calendar_event"/>
            <field name="state">code</field>
            <field name="code">model._cron_workshop_appointment_reminder()
            </field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">1</field>
        </record>
    </data>

    <data noupdate="1">
        <record forcecreate="True" id="ir_cron_workshop_delivery_reminder"
                model="ir.cron">
            <field name="name">Delivery Reminder</field>
            <field name="model_id" ref="workshop.model_workshop_job_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_workshop_delivery_reminder()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">2</field>
        </record>
    </data>
</odoo>
