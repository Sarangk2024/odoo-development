<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    workshop job order model form view -->
    <record id="workshop_job_order_form_view" model="ir.ui.view">
        <field name="name">workshop.job.order.form.view</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <form string="Form">
                <header>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"
                            invisible="state !='draft'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state not in ['confirmed','in_progress']"/>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary"
                            invisible="state !='confirmed'"/>
                    <button name="action_done" type="object" string="Done"
                            class="btn-primary"
                            invisible="state !='in_progress'"/>
                    <button name="action_quotation" type="object"
                            string="Create Quotation" class="btn-primary"
                            invisible="state !='done'"/>
                    <button name="action_invoiced" type="object"
                            string="Create Invoice" class="btn-primary"
                            invisible="state not in['done','quotation']"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,done,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotation" type="object"
                                class="oe_stat_button" icon="edit_square"
                                invisible="quotation_count == 1">
                            <field name="quotation_count" widget="statinfo"
                                   string="Delivery"/>
                        </button>
                        <button name="action_view_invoice" type="object"
                                class="oe_stat_button" icon="edit_square"
                                invisible="invoice_count == 1">
                            <field name="invoice_count" widget="statinfo"
                                   string="Invoices"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="sequence"
                                   placeholder="Sequence Number" nolabel="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer Details">
                            <field name="customer_id"
                                   readonly="state!='draft'"/>
                            <field name="phone_number"/>
                            <field name="vehicle_id" readonly="state!='draft'"/>
                            <field name="mechanic_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Work Details">
                            <field name="job_type_id"
                                   options="{'no_create':'1','no_edit':'1'}"
                                   readonly="state!='draft'"/>
                            <field name="bay_id"
                                   options="{'no_create':'1','no_edit':'1'}"
                                   readonly="state!='draft'"/>
                            <field name="job_date"/>
                            <field name="warranty_status"/>
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="Order lines">
                                <field name="job_order_line_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="product_unit_price"/>
                                        <field name="line_subtotal"/>
                                    </list>
                                </field>

                            </page>
                            <page string="Repair info">
                                <field name="repair_instructions"
                                       placeholder="Write down the Repair Instructions"/>
                            </page>
                            <page string="Customer notes">
                                <field name="customer_notes"
                                       placeholder="Write down the Customer Notes"/>

                            </page>
                            <page string="Vehicle images">
                                <field name="image_id"
                                       widget="many2many_binary"/>
                            </page>
                        </notebook>
                    </group>
                    <h4>
                        <group class="oe_subtotal_footer border-top-0 flex-column gap-3">
                            <field name="total_amount"/>
                        </group>
                    </h4>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!--    workshop job order model list view    -->
    <record id="workshop_job_order_list_view" model="ir.ui.view">
        <field name="name">workshop.job.order.list.view</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="mechanic_ids"/>
                <field name="bay_id"/>
                <field name="job_date"/>
                <field name="warranty_status"/>
                <field name="state"/>
                <field name="total_amount"/>
            </list>
        </field>
    </record>

    <!--    workshop joborder model search   -->
    <record id="workshop_job_order_search" model="ir.ui.view">
        <field name="name">workshop.job.order.model.search</field>
        <field name="model">workshop.job.order</field>
        <field name="arch" type="xml">
            <search string="workshop job order">
                <field name="customer_id"/>
                <field name="vehicle_id"/>
                <field name="mechanic_ids"/>
                <field name="bay_id"/>
                <field name="job_date"/>
                <field name="state"/>

                <filter string="Status Done" name="Done"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Status Cancel" name="Cancel"
                        domain="[('state', '=', 'cancel')]"/>
                <group>
                    <filter string="work Status" name="state"
                            context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!--    workshop job order model action   -->
    <record id="workshop_job_order_action" model="ir.actions.act_window">
        <field name="name">Work Order</field>
        <field name="res_model">workshop.job.order</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>