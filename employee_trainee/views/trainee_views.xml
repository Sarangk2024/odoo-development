<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_trainee_form" model="ir.ui.view">
        <field name="name">employee.trainee.form</field>
        <field name="model">employee.trainee</field>
        <field name="arch" type="xml">
            <form string="Employee Trainee">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
