<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_workshop_job_order" model="mail.template">
            <field name="name">Work Done</field>
            <field name="model_id" ref="workshop.model_workshop_job_order"/>
            <field name="email_from">{{ object.company_id.email}}</field>
            <field name="subject">Job Order Completed: {{ object.sequence}}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p>
                        Dear <t t-out="object.customer_id.name"/>,
                        <br/><br/>
                        Your workshop job order <strong><t t-out="object.sequence"/></strong> has been completed.
                        <br/>
                        Your total amount is <strong><t t-out="object.total_amount"/></strong>.
                    </p>
                    <p>
                        Regards,<br/>
                        <t t-out="object.company_id.name or ''"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>