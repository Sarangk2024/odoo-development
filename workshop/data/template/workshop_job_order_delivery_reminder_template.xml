<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_workshop_delivery_reminder"
                model="mail.template">
            <field name="name">Delivery Reminder</field>
            <field name="model_id" ref="workshop.model_workshop_job_order"/>
            <field name="email_from">{{ object.company_id.email}}</field>
            <field name="subject">Delivery Reminder: {{ object.sequence}}
            </field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p>
                        Dear<t t-out="object.customer_id.name"/>,
                        <br/>
                        <br/>
                        Your Appointment for job order
                        <strong>
                            <t t-out="object.job_type_id.job_type"/>
                        </strong>
                        has completed. Please take the vehicle.!
                        <br/>
                        Work Order details:
                        <br/>
                        <strong>
                            sequence:
                            <t t-out="object.sequence"/>
                            <br/>
                            Name:
                            <t t-out="object.customer_id.name"/>
                            <br/>
                            Vehicle:
                            <t t-out="object.vehicle_id.license_plate"/>
                            <br/>
                            Job Type:
                            <t t-out="object.job_type_id.job_type"/>
                            <br/>
                        </strong>

                    </p>
                    <p>
                        Regards,
                        <br/>
                        <t t-out="object.company_id.name or ''"/>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>