<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

<!--    main view lis view      -->
    <record id="real_estate_list_view" model="ir.ui.view">
        <field name="name">real.estate.list.view</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list decoration-success="offer_id" decoration-bf="state=='offer_accepted'"
                  decoration-muted="state=='sold'">
                <field name="name"/>
                <field name="description"/>
                <field name="state"/>
                <field name="area"/>
                <field name="email"/>
                <field name="date" optional="true"/>
                <field name="property_type_id"/>
            </list>
        </field>
    </record>


    <!--     main view form     -->
    <record id="real_estate_view_form" model="ir.ui.view">
        <field name="name">real.estate.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">

            <form string="Test">
                <header>
                    <button name="submit_action" type="object" string="Submit" invisible="state =='sold'"/>
                    <button name="cancel_action" type="object" string="Cancel" invisible="state=='sold'"/>

                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Property details">
                            <field name="date"/>
                            <field name="state"/>
                            <field name="description"/>
                            <field name="expected_price"/>
                            <field name="price"/>
                            <field name="tax"/>
                            <field name="total"/>
                            <field name="active"/>
                            <field name="garden"/>
                            <field name="area" invisible="not garden"/>
                            <field name="orientation" invisible="not garden"/>
                            <field name="property_type_id" options="{'`no_create':True`,'no_edit':True}"/>
                            <field name="tag_id" widget="many2many_tags"
                                   options="{'color_field':'color' ,'on_tag_click': 'edit_color'}"/>
                        </group>
                        <group string="Contact details">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>
                    </group>
                    <group>
                        <notebook>
                            <page string="Description">
                                <group>
                                    <field name="zip_code"/>
                                    <field name="delivery_date"/>
                                    <field name="city"/>
                                </group>
                            </page>
                            <page string="Offers">
                                <field name="offer_id" readonly="state=='offer_accepted'"/>
                            </page>

                            <page string="Other info">
                                <group>
                                    <field name="buyer_id"/>
                                    <field name="sales_person_id"/>
                                    <field name="offer_id"/>
                                    <field name="best_price"/>
                                </group>
                            </page>

                        </notebook>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

<!--    main view  search view      -->
    <record id="real_estate_search" model="ir.ui.view">
        <field name="name">real.estate.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Real Estate">
                <field name="name"/>
                <field name="email"/>
                <field name="area" filter_domain="[('area','>=', self)]"/>
                <field name="phone"/>
                <field name="city"/>
                <field name="state"/>
                <separator/>
                <filter string="Available" name="available" domain="[('active', '=', True)]"/>
                <filter string="Not Available" name="active" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="post code" name="zip_code"
                            context="{'group_by':'zip_code', 'residual_visible':True}"/>
                    <filter string="post code new" name="zip_code"
                            context="{'group_by':'zip_code', 'residual_visible':False}"/>


                    <filter string="negative" name="price" domain="[('price', '&lt;', 0)]"/>
                    <filter string="positive" name="price" domain="[('price', '&gt;', 0)]"/>
                    <filter string="No Price" name="price"
                            domain="['!', ('price', '=', 0)]"
                    />

                    <filter string="Date" name="date" context="{'group_by':'date'}"/>
                </group>
            </search>
        </field>
    </record>

<!--    main  model action      -->

    <record id="action_real_estate" model="ir.actions.act_window">
        <field name="name">Create new</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_available': True}</field>
    </record>

<!--    offer model action for stat button  -->

    <record id="action_real_estate_property_offer" model="ir.actions.act_window">
        <field name="name">Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=' , active_id)]</field>
    </record>

</odoo>


